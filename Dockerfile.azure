# One image for Azure: the simulator, the dashboard and the buyer job pick their command.
# Build from the repository root: az acr build -f Dockerfile.azure .
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE NOTICE.md ./
RUN uv sync --frozen --no-dev --no-editable --no-install-project --extra sim --extra anthropic
COPY src ./src
# Editable, so deals.py finds src/ for the decision tree source links.
RUN uv sync --frozen --no-dev --extra sim --extra anthropic && useradd --create-home tacto
COPY data ./data
COPY docs/results ./docs/results
USER tacto
ENV PATH=/app/.venv/bin:$PATH PORT=8080
CMD ["sh", "-c", "exec tacto-sim serve --host 0.0.0.0 --port ${PORT}"]
