# Local configuration template. Real environment variables take precedence.
# Keep real keys in an ignored .env; no local test needs them.
ARENA_URL=http://127.0.0.1:8000
ARENA_API_KEY=
ARENA_DATA=data

# The routed buyer uses OpenAI Responses. Hosted arena access is configured separately.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_EFFORT=low
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_CONCURRENT=10
# Leave the strong model empty to disable it. Low is the measured effort setting.
LLM_STRONG_MODEL=gpt-6-astra
LLM_STRONG_EFFORT=low
