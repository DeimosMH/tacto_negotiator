# Local configuration template. Real environment variables take precedence.
# Keep real keys in an ignored .env; no local test needs them.
ARENA_URL=http://127.0.0.1:8000
ARENA_API_KEY=
ARENA_DATA=data

# The routed buyer's model: Claude Opus 5.5 at high effort, in fast mode (the final's settings).
# LLM_SPEED=fast is the default for Claude; LLM_SPEED=standard turns fast mode off.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_SPEED=fast
LLM_API_KEY_ANTHROPIC=
LLM_MAX_CONCURRENT=10
# Leave the strong model empty to disable it.
LLM_STRONG_MODEL=
